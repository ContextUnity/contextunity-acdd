# Place this block after other ignore rules. It ignores scratch files under
# `.acdd/tmp/`, restores the configuration trees, and leaves runtime state
# excluded by the final six patterns.
.acdd/tmp/
!/.acdd/
!/.acdd/profile.yaml
!/.acdd/frameworks/
!/.acdd/frameworks/**
.acdd/*.sqlite*
.acdd/*.lock
.acdd/*.log
.acdd/*.jsonl
.acdd/tasks/
.acdd/checkpoints.json
