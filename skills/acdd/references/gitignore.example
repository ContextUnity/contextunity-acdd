# Place this block after other ignore rules. It ignores worktrees and runtime
# artifacts under `.acdd/` while keeping `.acdd/workflows/**`, `.acdd/specs/**`,
# `.acdd/lint/**`, and `.acdd/frameworks/**` tracked in Git.
/.worktrees/
!/.acdd/
!/.acdd/workflows/
!/.acdd/workflows/**
!/.acdd/specs/
!/.acdd/specs/**
!/.acdd/lint/
!/.acdd/lint/**
!/.acdd/frameworks/
!/.acdd/frameworks/**
.acdd/*.sqlite*
.acdd/*.lock
.acdd/*.log
.acdd/*.json
.acdd/*.jsonl
.acdd/reports/
.acdd/run/
.acdd/tmp/
