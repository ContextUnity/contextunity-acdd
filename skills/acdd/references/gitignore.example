# Place this block after other ignore rules. It restores the configuration trees,
# then leaves runtime state excluded by the final six patterns.
!/.acdd/
!/.acdd/profile.yaml
!/.acdd/frameworks/
!/.acdd/frameworks/**
.acdd/*.sqlite*
.acdd/*.lock
.acdd/*.log
.acdd/*.jsonl
.acdd/tasks/
.acdd/checkpoints.json
