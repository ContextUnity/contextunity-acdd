# Place this block after other ignore rules. It ignores worktrees and runtime
# artifacts under `.acdd/` while keeping `.acdd/profile.yaml`, `.acdd/profiles/**`,
# and `.acdd/frameworks/**` tracked in Git.
/.worktrees/
!/.acdd/
!/.acdd/profile.yaml
!/.acdd/profiles/
!/.acdd/profiles/**
!/.acdd/frameworks/
!/.acdd/frameworks/**
.acdd/*.sqlite*
.acdd/*.lock
.acdd/*.log
.acdd/*.json
.acdd/*.jsonl
.acdd/run/
.acdd/tmp/
.acdd/backup-0.5/
