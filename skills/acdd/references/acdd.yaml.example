# Example acdd.yaml adapter
# Points to repository resources, spec configurations, preset, and module toggles.

preset: full
roots:
  - src
  - crates # Include crates for multi-crate workspaces.
docs:
  - README.md
  - docs
ignore:
  - target
  - node_modules
  - .venv
  - .git
  - .acdd

# Reader paths blocked before reads and exports (gitignore-style patterns).
sensitive: ['.env*', 'secrets/**']

# Spec configurations and unified state configuration
specs:
  milestones:
    path: docs/milestones
    prefixes: [AC]
    digits: 3
  plans:
    path: docs/plans
    prefixes: [PLAN]
    digits: 3
  # Optional repository memory + gitignored retrospective subcollection
  # (disjoint because `ignore` defaults to ["archive", ".*", "README.md", "AGENTS.md", "CLAUDE.md"]):
  # memories:
  #   path: docs/memories
  #   base: memory
  #   prefixes: [MEM]
  #   digits: 3
  # retrospectives:
  #   path: docs/memories/.retro
  #   ref: retrospective
  #   prefixes: [RETRO]
  #   digits: 3
  #   roadmap: false

workflows_dirs:
  - .acdd/workflows
state_db: ".acdd/state.sqlite"
retain_traces: 20

modules:
  code: true
  docs: true
  state: true
  blackboard: true

# Linked workspaces (optional)
# linked_workspaces:
#   - name: shared-core
#     path: ../shared-core
#     enabled: true
#     roots:
#       - src
#     docs:
#       - docs

# MCP response policy
response:
  detail: compact
  page_size: 12
  file_uris: false
  max_output_bytes: 65536

# External spec schemas (.acdd/specs/*.yaml) and lint rules (.acdd/lint/*.yaml)
# specs_dirs:
#   - .acdd/specs
# lint_dirs:
#   - .acdd/lint
#
# Optional roadmap display defaults
# roadmap:
#   color: auto            # auto | always | never (honors NO_COLOR)
#   badges: [status, readiness]
#   group_by: wave         # wave | spec | <field>
