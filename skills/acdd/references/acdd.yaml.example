# Example acdd.yaml adapter
# Points to repository resources, spec collections, and module toggles.

roots:
  - src
  - crates # Include crates for multi-crate workspaces.
docs:
  - README.md
  - docs
ignore:
  - target
  - node_modules
  - .venv
  - .git
  - .acdd

# Reader paths blocked before reads and exports (gitignore-style patterns).
sensitive: ['.env*', 'secrets/**']

# Specification collections and unified state configuration (0.6.2)
specs:
  milestones:
    path: docs/milestones
    prefixes: [AC]
    digits: 3
  plans:
    path: docs/plans
    prefixes: [PLAN]
    digits: 3

profiles_dirs:
  - .acdd/profiles
state_db: ".acdd/state.sqlite"
retain_traces: 20

modules:
  code: true
  docs: true
  state: true
  blackboard: true

# Linked workspaces (optional)
# linked_workspaces:
#   - name: shared-core
#     path: ../shared-core
#     enabled: true
#     roots:
#       - src
#     docs:
#       - docs

# MCP response policy
response:
  detail: compact
  page_size: 12
  file_uris: false
  max_output_bytes: 65536

# Optional architectural zones, rules, and syntax invariant configuration
# architecture:
#   unused_public_api: false
#   complexity:
#     severity: warn
#     invariant: INV-BOUNDED-STRUCTURAL-COMPLEXITY
#   zones:
#     core: ["crates/core/src/**"]
#   rules:
#     - id: ARCH-ACYCLIC-CORE
#       severity: error
#       kind: forbid_cycles
#       from: { zones: ["core"] }
#       depth: 2
