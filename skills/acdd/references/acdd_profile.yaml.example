# =============================================================================
# CANONICAL HIERARCHICAL ACDD PROFILE SPECIFICATION (v2)
# Standalone reference example (`inherit: none`) of a declarative ACDD profile.
#
# Tip: Most repositories only need a compact overlay (`inherit: code` or
# `inherit: default`, `gates_merge: patch`) in `.acdd/profile.yaml` binding
# project `commands`, `scope_args_by_pattern`, and gate overrides.
#
# Core Architectural Principles:
# 1. Everything is a Gate (`gates:`):
#    - Agent Gate:   has `role: <id>`    -> Claimed by agent worker via `acdd claim`.
#    - Command Gate: has `command: <cmd>` -> Executed autonomously by engine (`acdd verify`).
#    - Container:    has `gates: [...]` or `tasks: { gates: [...] }` -> Nests child gates.
# 2. Git & Save Policy (`git:` and `save:`):
#    - `git`: `isolation` (`worktree|in_place`), `worktrees` (`manual|managed`),
#      `commit_mode` (`plumbing|cli|manual`), `integrate` (`manual|rebase-ff|ff-only|no-ff|squash`).
#    - `save.pre`: `none | snapshot`, `save.post`: `none | snapshot | commit`,
#      `save.immutable: true`, `save.archive: true`, `save.prune: true`,
#      `save.git_commit_note: default`.
# 3. Guidance & Contours Catalog (`guidance:` and `contours:`):
#    - Strict slot keys in `guidance:` (`{ inline: "..." }` for inline text).
#    - Explicit review contours in `contours:`.
# =============================================================================

version: 2
inherit: none

git:
  isolation: worktree
  worktrees: manual
  commit_mode: plumbing
  integrate: manual

save: commit

tags:
  - default

default_tools:
  - acdd_read
  - acdd_guide
  - acdd_state
  - acdd_claim
  - acdd_verify
  - acdd_submit
  - acdd_blackboard

limits:
  max_guidance_bytes: 32768
  max_log_bytes: 1048576
  max_capture_bytes: 262144
  max_line_bytes: 65536
  diagnostic_inline_bytes: 4096
  max_metadata_bytes: 2048       # 2 KiB limit for arbitrary task/gate metadata & metrics
  max_trace_summary_bytes: 2048  # Tail output size for execution traces
  max_command_timeout_seconds: 1800

git_commit_notes:
  default:
    ref_name: refs/notes/acdd
    max_bytes: 2048              # 2 KiB limit for Git notes attached to refs/notes/acdd
    format: markdown
    sections:
      - duration                 # Total elapsed time
      - tasks_summary            # Completed tasks count and durations
      - review_cycles            # Iterations and review rejections count
      - diff_breakdown           # Line additions/deletions categorized by src, tests, docs
      - test_suite               # Test counts passed/failed and linter status
      - topology                 # Upstream blockers and downstream dependents

# Declarative proof catalog (custom schemas; built-in kinds: none, contract, command, call, review)
proofs:
  blueprint:
    description: "Architectural blueprint with grounded citations and per-task slices"
    schema:
      type: object
      required:
        - cited_invariants
        - cited_symbols
        - global_negative_boundaries
        - blackboard_decision_id
        - tasks
      properties:
        cited_invariants:
          type: array
          items: { type: string }
        cited_symbols:
          type: array
          items: { type: string }
        global_negative_boundaries:
          type: array
          items: { type: string }
        blackboard_decision_id: { type: string }
        tasks:
          type: object
          additionalProperties:
            type: object
            required:
              - layer
              - summary
              - exported_interfaces
              - negative_boundaries
              - incoming_seams
              - outgoing_seams
            properties:
              layer: { type: string }
              summary: { type: string }
              exported_interfaces:
                type: array
                items: { type: string }
              negative_boundaries:
                type: array
                items: { type: string }
              verification_seam: { type: string }
              incoming_seams:
                type: array
                items:
                  type: object
                  required: [source_task, contract_type, contract_ref, specification]
                  properties:
                    source_task: { type: string }
                    contract_type:
                      type: string
                      enum: ["seam_dependency", "shared_type", "shared_helper"]
                    contract_ref: { type: string }
                    specification: { type: string }
              outgoing_seams:
                type: array
                items:
                  type: object
                  required: [target_task, contract_type, contract_ref, specification]
                  properties:
                    target_task: { type: string }
                    contract_type:
                      type: string
                      enum: ["seam_dependency", "shared_type", "shared_helper"]
                    contract_ref: { type: string }
                    specification: { type: string }

# Worker roles and recommended models
roles:
  contract_author:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'sol-6.1:high'
    guidance: "Lead architectural planning for this task before writing tests: trace data flow, define typed invariants, specify negative boundaries, and write compiling runtime-red seam tests. Post a build-targeted draft to acdd_blackboard."

  builder:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'gpt6-luna:xhigh'
      - 'sol-6.1:medium'
    guidance: "Implement the approved contract inside the declared scope and verify tests."

  independent_reviewer:
    mode: subagent
    reuse_on_reject: false
    models:
      - 'sol-6.1:xhigh'
    guidance: "Use a reviewer worker independent from the builder. Audit subsystem integration, performance, and test hygiene. Reject superficial heuristics and duplicate algorithms. Submit review proof across contours, then claim and submit deliver in the same reviewer session."

  architect:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'sol-6.1:high'
    guidance: "Ground architectural decisions in repository symbols, invariants, and extension seams. Define Clean Architecture layer boundaries, per-task slices, and cross-task seams, then record the decision on acdd_blackboard."

# Scoped arguments augment the selected command for affected paths.
scope_args_by_pattern:
  "src/main.rs": "--bin acdd"
  "src/**/*.rs": "--lib"
  "crates/acdd-core/**/*.rs": "--package acdd-core --lib"
  "crates/acdd-index/**/*.rs": "--package acdd-index --lib"
  "crates/acdd-state/**/*.rs": "--package acdd-state --lib"
  "tests/*.rs": "--test {file_stem}"
  "tests/acdd/**/*.rs": "--test acdd"

# Registered commands
commands:
  rust-check-and-test:
    test_filter: "{test}"
    output: &test_output
      counts:
        passed: '(?m)\b(\d+) passed\b'
        failed: '(?m)\b(\d+) failed\b'
      require_counts: true
      noise: ['^\s*(Compiling|Downloading|Finished|Checking)\b', '^✔']
      compile_errors:
        include: ['^error(\[E\d+\])?:', 'panicked at', '^FAIL ', '^AssertionError:', '^\s*AssertionError']
        exclude: ['^error: test failed']
      tests:
        target: '(?m)(?:^\s*Running\s+(?:unittests\s+)?|"kind":\s*\[[^\]]*"test"[^\]]*\].*?"src_path":\s*"|--test\s+|^===\s+RUN\s+|^PASS\s+|^FAIL\s+)([^\s"\\)]+)'
        passed: '(?m)(?:^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+ok\b|(?:\b|\s)([A-Za-z0-9_:]+)\s+PASSED\b|^\s*✓\s+([^\n]+)|---\s+PASS:\s+([A-Za-z0-9_:]+))'
        failed: '(?m)(?:^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+FAILED\b|(?:\b|\s)([A-Za-z0-9_:]+)\s+FAILED\b|^\s*✕\s+([^\n]+)|---\s+FAIL:\s+([A-Za-z0-9_:]+))'
        ignored: '(?m)(?:^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+ignored\b|(?:\b|\s)([A-Za-z0-9_:]+)\s+SKIPPED\b|^\s*○\s+([^\n]+)|---\s+SKIP:\s+([A-Za-z0-9_:]+))'
    by_pattern:
      "**/*.py": "pytest {test_filter}"
      "**/*.{ts,tsx,js,jsx,vue}": "npm test -- {test_filter}"
      "**/*.go": "go test ./... {test_filter}"
      "**/*.rs": "cargo clippy --all-targets --all-features -- -D warnings && cargo test {test_filter}"
    description: "Run strict repository checks and lints followed by the test suite."

  check_full_repo:
    output: *test_output
    by_pattern:
      "**/*.py": "pytest"
      "**/*.{ts,tsx,js,jsx,vue}": "npm test"
      "**/*.go": "go test ./..."
      "**/*.rs": "cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace --lib"
    description: "Run the full repository verification commands."
    timeout_seconds: 1800

  lint:
    output:
      require_counts: false
      noise: ['^\s*(Checking|Compiling|Finished)\b']
      compile_errors: ['^error(\[E\d+\])?:']
    by_pattern:
      "**/*.py": "ruff check ."
      "**/*.{ts,tsx,js,jsx,vue}": "npm run lint"
      "**/*.go": "go vet ./..."
      "**/*.rs": "cargo clippy --workspace --all-targets --all-features -- -D warnings"
    description: "Run language-specific linter without running tests."

  test:
    test_filter: "{test}"
    output:
      counts:
        passed: '(?m)\b(\d+) passed\b'
        failed: '(?m)\b(\d+) failed\b'
      require_counts: false
      noise: ['^\s*(Compiling|Downloading|Finished|Checking)\b', '^✔']
      compile_errors:
        include: ['^error(\[E\d+\])?:', 'panicked at', '^FAIL ', '^AssertionError:', '^\s*AssertionError']
        exclude: ['^error: test failed']
      tests:
        target: '(?m)(?:^\s*Running\s+(?:unittests\s+)?|"kind":\s*\[[^\]]*"test"[^\]]*\].*?"src_path":\s*"|--test\s+|^===\s+RUN\s+|^PASS\s+|^FAIL\s+)([^\s"\\)]+)'
        passed: '(?m)(?:^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+ok\b|(?:\b|\s)([A-Za-z0-9_:]+)\s+PASSED\b|^\s*✓\s+([^\n]+)|---\s+PASS:\s+([A-Za-z0-9_:]+))'
        failed: '(?m)(?:^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+FAILED\b|(?:\b|\s)([A-Za-z0-9_:]+)\s+FAILED\b|^\s*✕\s+([^\n]+)|---\s+FAIL:\s+([A-Za-z0-9_:]+))'
        ignored: '(?m)(?:^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+ignored\b|(?:\b|\s)([A-Za-z0-9_:]+)\s+SKIPPED\b|^\s*○\s+([^\n]+)|---\s+SKIP:\s+([A-Za-z0-9_:]+))'
    by_pattern:
      "**/*.py": "pytest {test_filter}"
      "**/*.{ts,tsx,js,jsx,vue}": "npm test -- {test_filter}"
      "**/*.go": "go test ./... {test_filter}"
      "**/*.rs": "cargo test {test_filter}"
    description: "Run test suite across supported languages."

# Review contours catalog
contours:
  paths:
    description: "Verify changes stay within the task's admitted write perimeter and preserve protected paths."
    criteria:
      - "Compare every changed, staged, untracked, and generated file with the task's initial scope and admitted extensions."
      - "Verify configuration, credentials, and sibling project paths were not modified outside scope."

  claims:
    description: "Verify each accepted contract claim is implemented and supported by production-seam evidence."
    criteria:
      - "Trace every invariant and acceptance criterion to the production code path and real seam test."

  concurrency:
    description: "Verify concurrent operations cannot admit stale authority, lose receipts, or publish partial task state."
    criteria:
      - "Check transaction boundaries, revision fencing, claim ownership, and rollback safety."

  project_isolation:
    description: "Verify task data, profiles, paths, and Git operations stay within the owning workspace and project."
    criteria:
      - "Confirm workspace resolution confines paths, symlinks, and task rows to the active repository root."

  administration:
    description: "Verify protected configuration, migration, profile pins, and privileged delivery behavior remain governed."
    criteria:
      - "Check schema integrity, profile pins, Git hooks, and landed receipt commits."

# Central guidance catalog
guidance:
  task.contract:
    description: "PRODUCTION-SEAM CONTRACT AUTHORING & RUNTIME-RED PROOF"
    criteria:
      - "Analyze subsystem data flow, define typed invariants, and specify negative boundaries before authoring tests."
      - "Compile a runtime-red seam test failing on assertions (exit code 101/1/134) as executable proof of the contract."
      - "Extend table-driven cases additively for existing units; author dedicated test functions for distinct capabilities."
      - "Avoid duplicate mechanisms or touching protected paths outside admitted task scope."

  task.code: "Implement the accepted seam with the smallest change that satisfies the task contract."

  task.review:
    description: "INDEPENDENT REVIEW CORE INVARIANTS & ENGINEERING PRINCIPLES"
    criteria:
      - "Evaluate diffs in full subsystem context using ACDD MCP tools (`code_map_inspect`, `code_map_impact`, `ast_grep_search`, `acdd_read`)."
      - "Reject superficial heuristics, parallel hardcoded lookup lists, duplicate algorithms, and monolithic test functions."
      - "Treat review contours as an analytical framework and formulate constructive, evidence-backed findings."

  hitl.careless: "HITL level CARELESS: allow autonomous changes; escalate only for unrecoverable infrastructure or circular dependencies."
  hitl.curious: "HITL level CURIOUS: report interface evolution; escalate breaking public APIs or irreversible storage changes."
  hitl.pro: "HITL level PRO: allow internal helpers; escalate public APIs, CLI/MCP surfaces, storage schemas, and cross-milestone contracts."
  hitl.paranoic: "HITL level PARANOIC: require explicit human approval for every new symbol or signature before contract admission."

  milestone.synthesis: "Ground the milestone blueprint in repository symbols and invariants, define Clean Architecture slices and cross-task seams, and record the decision on acdd_blackboard."
  milestone.blueprint_review: "Verify cited symbols and invariants exist, Clean Architecture boundaries hold, and per-task seam slices are consistent."
  milestone.review: "Audit the integrated milestone diff against target base for cohesion, performance invariants, and analytical contours."
  milestone.polish: "Resolve integration failures or reviewer findings on the integrated milestone branch."
  milestone.handoff: "Terminal milestone delivery, capturing closure summary, receipts, and archiving completed spec."

# Hierarchical workflow: blueprint synthesis -> per-task container -> verify / polish / review / handoff.
gates:
  - id: blueprint_synthesis
    gates:
      - id: synthesize
        role: architect
        guidance: [milestone.synthesis, hitl.pro]
        tools:
          - code_map_inspect
          - code_map_impact
          - code_map_overview
          - code_map_search
          - ast_grep_search
          - acdd_read
          - acdd_blackboard
        proof: blueprint
        save:
          pre: snapshot
          post: snapshot
        pass: review
      - id: review
        role: independent_reviewer
        proof: review
        guidance: [milestone.blueprint_review, hitl.pro]
        contours: [claims, project_isolation, administration]
        independent_from: [synthesize]
        fail: synthesize
        tools:
          - code_map_inspect
          - code_map_impact
          - code_map_search
          - ast_grep_search
          - acdd_read
          - acdd_blackboard
        save:
          immutable: true

  - tasks:
      gates:
        - id: contract
          role: contract_author
          tools: [acdd_read, acdd_verify, acdd_submit, acdd_blackboard]
          command: test
          proof: contract
          checks: [code.seam]
          guidance: [task.contract, hitl.pro]
          expected_failure:
            exit_codes: [1, 101, 134]
          save:
            post: snapshot
          pass: contract_review

        - id: contract_review
          role: independent_reviewer
          proof: review
          contours: [paths, claims]
          independent_from: [contract]
          need: [contract]
          guidance: [task.review, hitl.pro]
          save:
            immutable: true
          pass: build
          fail: contract

        - id: build
          role: builder
          guidance: [task.code, hitl.pro]
          command: rust-check-and-test
          proof: command
          checks: [code.seam]
          save:
            pre: snapshot
            post: snapshot
          pass: review

        - id: review
          role: independent_reviewer
          proof: review
          guidance: [task.review, hitl.pro]
          contours: [paths, claims, concurrency, project_isolation, administration]
          independent_from: [build]
          need: [build]
          fail: build
          save:
            immutable: true
          pass: deliver

        - id: deliver
          role: independent_reviewer
          guidance: [hitl.pro]
          receipt: true
          need: [build, review]
          independent_from: [build]
          fail: build
          save:
            immutable: true
            post: commit
            git_commit_note: default

  - id: verify
    command: check_full_repo
    proof: command
    max_attempts: 2
    pass: integration_review
    fail: polish

  - id: polish
    role: builder
    scope:
      - ".acdd/profile.yaml"
      - ".acdd/profiles/**"
      - ".acdd/frameworks/**"
      - "docs/**"
      - "skills/**"
      - "AGENTS.md"
      - "**/AGENTS.md"
      - "README.md"
      - ".gitignore"
    command: check_full_repo
    proof: command
    max_attempts: 2
    guidance: [milestone.polish, hitl.pro]
    tools: [acdd_read, search_docs, get_doc, acdd_blackboard, acdd_verify, acdd_submit]
    pass: verify
    save:
      pre: snapshot
      post: snapshot

  - id: integration_review
    role: independent_reviewer
    proof: review
    max_attempts: 2
    guidance: [milestone.review, hitl.pro]
    contours: [paths, claims, concurrency, project_isolation, administration]
    independent_from: [polish, "tasks.build"]
    need: [verify]
    pass: handoff
    fail: polish
    save:
      immutable: true

  - id: handoff
    role: independent_reviewer
    independent_from: [polish, "tasks.build"]
    need: [verify, integration_review]
    receipt: true
    guidance: [milestone.handoff, hitl.pro]
    fail: polish
    save:
      immutable: true
      post: commit
      archive: true
      prune: true
      git_commit_note: default
