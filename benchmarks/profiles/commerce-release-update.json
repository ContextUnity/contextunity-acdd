{
  "schema_version": 1,
  "name": "commerce-release-update",
  "project": "commerce-release-update",
  "workspace_root": "../../contextunity/.worktrees/commerce-release-update",
  "acdd_binary": "../../target/release/acdd",
  "scope_note": "Primary control benchmark against commerce-release-update (with linked traverse and gridviewspec workspaces enabled in acdd.yaml).",
  "scenarios": [
    {
      "id": "workspace_overview",
      "scenario": "Workspace orientation and index inventory",
      "acdd": {"tool": "code_map_overview", "arguments": {"detail": "compact", "limit": 30}}
    },
    {
      "id": "symbol_search",
      "scenario": "Locate run_matcher_pipeline in the commerce matcher module",
      "acdd": {
        "tool": "code_map_search",
        "arguments": {
          "pattern": "run_matcher_pipeline",
          "kind": "function",
          "path": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py",
          "limit": 10,
          "detail": "compact"
        }
      }
    },
    {
      "id": "symbol_inspection",
      "scenario": "Inspect matcher pipeline identity, signature, docs, and references",
      "acdd": {
        "tool": "code_map_inspect",
        "arguments": {
          "selector": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py:run_matcher_pipeline",
          "detail": "compact"
        }
      }
    },
    {
      "id": "source_snippet",
      "scenario": "Read the exact implementation of run_matcher_pipeline",
      "acdd": {
        "tool": "acdd_read",
        "arguments": {
          "selector": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py:run_matcher_pipeline"
        }
      }
    },
    {
      "id": "test_relationships",
      "scenario": "Find tests connected to run_matcher_pipeline",
      "acdd": {
        "tool": "code_map_query",
        "arguments": {
          "operation": "tests",
          "selector": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py:run_matcher_pipeline",
          "direction": "inbound",
          "limit": 30
        }
      }
    },
    {
      "id": "unresolved_evidence",
      "scenario": "Inspect workspace unresolved-reference evidence",
      "acdd": {"tool": "code_map_analyze", "arguments": {"target": "", "limit": 30}}
    },
    {
      "id": "impact_analysis",
      "scenario": "Trace incoming callers of run_matcher_pipeline",
      "acdd": {
        "tool": "code_map_impact",
        "arguments": {
          "selector": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py:run_matcher_pipeline",
          "depth": 1,
          "limit": 30
        }
      }
    },
    {
      "id": "symbol_explanation",
      "scenario": "Explain ownership and direct relationships for the matcher pipeline",
      "acdd": {
        "tool": "code_map_explain",
        "arguments": {
          "selector": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py:run_matcher_pipeline",
          "direction": "both",
          "show_doc": true,
          "detail": "compact"
        }
      }
    },
    {
      "id": "graph_slice_query",
      "scenario": "Retrieve a bounded graph slice around the matcher pipeline",
      "acdd": {
        "tool": "code_map_query",
        "arguments": {
          "operation": "slice",
          "selector": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py:run_matcher_pipeline",
          "depth": 1,
          "limit": 30
        }
      }
    },
    {
      "id": "workspace_diagnostics",
      "scenario": "Check workspace health, graph diagnostics, and cycles",
      "acdd": {"tool": "code_map_analyze", "arguments": {"target": "", "include_cycles": true, "limit": 30}}
    },
    {
      "id": "path_diagnostics_coverage",
      "scenario": "Check matcher pipeline source and indexing coverage",
      "acdd": {
        "tool": "code_map_analyze",
        "arguments": {
          "target": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py",
          "limit": 30
        }
      }
    },
    {
      "id": "removal_safety",
      "scenario": "Assess whether run_matcher_pipeline can be removed safely",
      "acdd": {
        "tool": "code_map_query",
        "arguments": {
          "operation": "prove_removal",
          "selector": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py:run_matcher_pipeline",
          "detail": "compact",
          "limit": 30
        }
      }
    },
    {
      "id": "ast_pattern_search",
      "scenario": "Find the Python function syntax with a Tree-sitter pattern",
      "acdd": {
        "tool": "ast_grep_search",
        "arguments": {
          "pattern": "def run_matcher_pipeline($$$ARGS) -> MatcherPipelineResult: $$$BODY",
          "language": "python",
          "path": "extensions/commerce/src/contextunity/commerce/modules/matcher/pipeline.py",
          "limit": 30
        }
      }
    },
    {
      "id": "documentation_search",
      "scenario": "Search Commerce documentation for matcher pipeline guidance",
      "acdd": {
        "tool": "search_docs",
        "arguments": {
          "query": "matcher pipeline exact linking adapter review",
          "include_excerpt": true,
          "limit": 10
        }
      }
    },
    {
      "id": "documentation_read",
      "scenario": "Read the Commerce package documentation",
      "acdd": {
        "tool": "get_doc",
        "arguments": {"path_or_id": "extensions/commerce/README.md", "detail": "full"}
      }
    },
    {
      "id": "tool_guide",
      "scenario": "Ask for agent guidance on using graph tools",
      "acdd": {"tool": "acdd_guide", "arguments": {"topic": "query"}}
    },
    {
      "id": "duplicate_detection",
      "scenario": "Query duplicate symbol candidates in extensions/commerce",
      "acdd": {
        "tool": "code_map_query",
        "arguments": {"operation": "duplicates", "path": "extensions/commerce", "min_lines": 10}
      }
    },
    {
      "id": "dead_tail_detection",
      "scenario": "Query dead-tail symbol candidates in extensions/commerce",
      "acdd": {
        "tool": "code_map_query",
        "arguments": {"operation": "dead_tails", "path": "extensions/commerce", "limit": 30}
      }
    }
  ]
}
